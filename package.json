{
  "name": "@akairos/pipeline",
  "version": "0.23.1",
  "type": "module",
  "license": "MIT",
  "bin": {
    "zzp": "./src/cli.ts",
    "zzhub-pipeline": "./src/cli.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "article-style.ts",
    "cover-snapshot.ts",
    "article-snapshot.ts",
    "ARTICLE-THEMES.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "build:wechat-preview": "vite build --config vite.wechat-preview.config.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "release:patch": "changelogen --release --patch --push",
    "release:minor": "changelogen --release --minor --push",
    "release:major": "changelogen --release --major --push"
  },
  "dependencies": {
    "@akairos/milkdown-article-plugins": "^0.1.6",
    "@akairos/myno": "0.4.7",
    "@akairos/typeset-studio": "0.4.0",
    "@chenglou/pretext": "0.0.8",
    "@happy-dom/global-registrator": "21.0.3",
    "happy-dom": "21.0.3",
    "image-size": "^2.0.2",
    "pngjs": "^7.0.0",
    "remark": "^15.0.1",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "cos-nodejs-sdk-v5": "^2.15.4"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "changelogen": "^0.6.2",
    "juice": "11.1.1",
    "remark-highlight-mark": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.10"
  }
}
